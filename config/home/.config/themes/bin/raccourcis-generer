    SORTIE.parent.mkdir(parents=True, exist_ok=True)
    nouveau = "\n".join(md)
    # n'écrit que si le contenu (hors date) a changé
    ancien = SORTIE.read_text() if SORTIE.exists() else ""
    sans_date = lambda s: re.sub(r"le \d\d/\d\d/\d{4} à \d\d:\d\d", "", s)
    if sans_date(ancien) != sans_date(nouveau):
        SORTIE.write_text(nouveau)
        if not SILENCE:
            print(f"Fiche écrite : {SORTIE}")
    elif not SILENCE:
        print(f"Fiche déjà à jour : {SORTIE}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
